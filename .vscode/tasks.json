{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "构建: Debug",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\build.ps1",
                "-Configuration", "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "构建: Test（供试用，含 pdb）",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\build.ps1",
                "-Configuration", "Test"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "构建: Release（发布，无 pdb）",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\build.ps1",
                "-Configuration", "Release",
                "-WithDocs"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "运行自测",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\Tests\\MQNetScan.Tests.exe",
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "启动程序",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\Release\\MQNetScan.exe",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never"
            }
        }
    ]
}
